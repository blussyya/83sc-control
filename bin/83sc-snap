#!/usr/bin/env python3
import json
import os
import subprocess
import sys

def _find_helper():
    for p in ("/usr/lib/83sc-control/helper.py",
              "/usr/local/lib/83sc-control/helper.py"):
        if os.path.exists(p):
            return p
    return "/usr/local/lib/83sc-control/helper.py"


r = subprocess.run(["sudo", "-n", _find_helper(), "status"],
                   capture_output=True, text=True)
if r.returncode != 0:
    sys.exit(f"snap: helper failed: {r.stderr.strip()}")
d = json.loads(r.stdout)

def g(v, default=0):
    try:
        return int(v)
    except (TypeError, ValueError):
        return default

leg, fans, fw = d["legion"], d["fans"], d["fwattr"]
label = sys.argv[1] if len(sys.argv) > 1 else ""
prof = d.get("profile") or "?"
print(f"  {label:<22} profile={prof:<12} powermode={str(leg.get('powermode')):<4} "
      f"fan={g(fans['fan1']['rpm']):>5}/{g(fans['fan2']['rpm']):<5} "
      f"cpu={g(fans['temp1']['value_mc'])//1000:>3}C gpu={g(fans['temp2']['value_mc'])//1000:>3}C "
      f"full={leg['fan_fullspeed']} unlock={leg['fan_unlock']} "
      f"pl1={fw['ppt_pl1_spl']['current_value']} pl2={fw['ppt_pl2_sppt']['current_value']}")
