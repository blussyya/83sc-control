post_install() {
    systemctl daemon-reload || true
    cat <<'MSG'

  83sc-control installed.

    sudo systemctl enable --now 83sc-driver-guard 83sc-thermal
    systemctl --user enable --now 83sc-kbd-idle

  Apply your settings in "83SC Control" (app menu), then run
  `sudo 83sc boot-save` so they replay at boot.

  Fan control needs legion_laptop with the 83SC fixes (LenovoLegionLinux
  >= v0.0.26). Check with: 83sc-fan show

MSG
}
post_upgrade() { post_install; }
pre_remove() {
    systemctl disable --now 83sc-thermal 83sc-driver-guard 2>/dev/null || true
}
