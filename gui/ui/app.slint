import { Button, ComboBox, LineEdit, Slider, GroupBox, VerticalBox, HorizontalBox,
         ListView, CheckBox, TabWidget, ScrollView } from "std-widgets.slint";

export struct CurvePoint {
    temp: int,
    rpm: int,
}

export struct Stats {
    cpu-temp: int,
    gpu-temp: int,
    fan-rpm: int,
    fan-max: int,
    cpu-mhz: int,
    gpu-watts: float,
    pl1: int,
    pl2: int,
    tau: int,
    powermode: int,
    mode-name: string,
    prochot: int,
    undervolt-mv: int,
    max-perf-pct: int,
    on-battery: bool,
}

export struct Extras {
    bat-capacity: int,
    bat-cycles: int,
    bat-health: int,
    bat-volts: float,
    bat-watts: float,
    bat-status: string,
    bat-model: string,
    kbd-max: int,
    refresh-hz: int,
    gpu-name: string,
    gpu-pl-max: int,
    igpu-mode: int,
}

// Most of the added controls are "label, slider, value" so they share one row
// component. It never writes to its own value: the parent owns the property and
// feeds it back in, which keeps the Rust side the single source of truth.
component SliderRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <int> step: 1;
    in property <int> value;
    in property <string> unit;
    in property <bool> enabled: true;
    callback changed(float);
    spacing: 10px;
    Text { text: root.label; width: 158px; color: #e8eaed;
           vertical-alignment: center; font-size: 12px; }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        enabled: root.enabled;
        changed(v) => { root.changed(round(v / root.step) * root.step); }
    }
    Text { text: root.value + " " + root.unit; width: 62px; color: #8ab4f8;
           vertical-alignment: center; font-weight: 700; font-size: 12px; }
}

component Note inherits Text {
    font-size: 11px;
    color: #9aa0a6;
    wrap: word-wrap;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    height: 22px;
    Text { text: root.label; width: 150px; color: #9aa0a6;
           font-size: 11px; vertical-alignment: center; }
    Text { text: root.value; color: #e8eaed; font-size: 12px;
           font-weight: 600; vertical-alignment: center; }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tint: #8ab4f8;
    background: #1e1f22;
    border-radius: 6px;
    min-width: 84px;
    height: 46px;
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text { text: label; font-size: 9px; color: #9aa0a6; }
        Text { text: value; font-size: 14px; font-weight: 700; color: tint; }
    }
}

export component MainWindow inherits Window {
    title: "83SC Control";
    min-width: 820px;
    min-height: 520px;
    preferred-height: 640px;
    preferred-width: 980px;
    background: #141517;

    in property <Stats> stats;
    in property <[CurvePoint]> curve;
    in property <[string]> profile-names;
    in property <string> status;
    in property <bool> status-error: false;
    in property <int> gpu-ctgp;
    in property <int> gpu-ppab;
    in property <bool> hw-ok: true;
    in property <Extras> extras;
    in property <[string]> refresh-options;
    in property <[string]> gpu-clients;

    in-out property <int> sel-profile: 0;
    in-out property <int> edit-pl1;
    in-out property <int> edit-pl2;
    in-out property <int> edit-tau;
    in-out property <int> edit-ctgp;
    in-out property <int> edit-ppab;
    in-out property <int> bind-mode: 0;
    in-out property <int> edit-uv;
    in-out property <int> edit-maxperf: 100;
    in-out property <bool> persist;
    in-out property <int> bind-power: 0;

    in-out property <int> edit-kbd;
    in-out property <int> edit-kbd-idle-secs: 5;
    in-out property <bool> tog-kbd-idle;
    in-out property <int> edit-refresh-idx;
    in-out property <int> edit-cpu-temp;
    in-out property <int> edit-gpu-temp;
    in-out property <int> edit-crossload;
    in-out property <int> edit-ec-tau;
    in-out property <int> edit-gpu-boost;
    in-out property <int> edit-gpu-offset;

    in-out property <bool> tog-conservation;
    in-out property <bool> tog-rapid;
    in-out property <bool> tog-fnlock;
    in-out property <bool> tog-winkey;
    in-out property <bool> tog-touchpad;
    in-out property <bool> tog-flip;
    in-out property <bool> tog-overdrive;
    in-out property <bool> tog-plcoupling;

    callback apply-curve();
    callback apply-power();
    callback apply-gpu();
    callback load-profile(int);
    callback apply-profile(int);
    callback save-profile(string);
    callback delete-profile(int);
    callback set-powermode(int);
    callback restore-stock();
    callback bind-profile(int, int);
    callback point-changed(int, int, int);
    callback apply-undervolt();
    callback apply-maxperf();
    callback set-persist(bool);
    callback bind-power-source(int, int);
    callback update-profile(int);
    callback set-flag(string, bool);
    callback set-charge-mode(bool, bool);
    callback apply-kbd(int);
    callback apply-kbd-idle(bool, int);
    callback apply-refresh(int);
    callback apply-ec-limits();
    callback apply-gpu-extra();

    VerticalBox {
        padding: 14px;
        spacing: 12px;

        // live telemetry, two rows so the window is not forced 1000px wide
        HorizontalLayout {
            spacing: 6px;
            Stat { label: "CPU"; value: stats.cpu-temp + "°C";
                   tint: stats.cpu-temp >= 90 ? #f28b82 : stats.cpu-temp >= 80 ? #fdd663 : #81c995; }
            Stat { label: "CPU CLOCK"; value: stats.cpu-mhz + " MHz"; }
            Stat { label: "FAN"; value: stats.fan-rpm + " rpm"; tint: #c58af9; }
            Stat { label: "GPU"; value: stats.gpu-temp + "°C"; tint: #81c995; }
            Stat { label: "GPU POWER"; value: round(stats.gpu-watts) + " W"; tint: #c58af9; }
            Stat { label: "POWER LIMIT"; value: stats.pl1 + " / " + stats.pl2 + " W"; }
            Stat { label: "PROCHOT"; value: stats.prochot;
                   tint: stats.prochot > 0 ? #f28b82 : #81c995; }
        }
        HorizontalLayout {
            spacing: 6px;
            Stat { label: "MODE"; value: stats.mode-name; tint: #fdd663; }
            Stat { label: "VOLTAGE"; value: stats.undervolt-mv + " mV";
                   tint: stats.undervolt-mv != 0 ? #81c995 : #9aa0a6; }
            Stat { label: stats.on-battery ? "BATTERY" : "AC"; value: stats.max-perf-pct + "% cpu";
                   tint: stats.on-battery ? #fdd663 : #8ab4f8; }
            Stat { label: "TAU"; value: stats.tau + " s"; }
            Rectangle { }
        }

        if !hw-ok: Rectangle {
            background: #3a2020;
            border-radius: 6px;
            height: 40px;
            Text {
                text: "legion_laptop not loaded — nothing to control. Load it, then restart this app.";
                color: #f28b82;
            }
        }

        HorizontalLayout {
            spacing: 12px;

            // profiles
            Rectangle {
                width: 232px;
                background: #1a1b1e;
                border-radius: 8px;
                // the column has seven widgets in it; without its own scroll the
                // profile list gets squeezed to a couple of rows
                ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: "Profiles"; font-size: 13px; font-weight: 700; color: #e8eaed; }
                    Rectangle {
                        // explicit height or the ListView collapses to nothing
                        height: 190px;
                        ListView {
                        for name[i] in profile-names: Rectangle {
                            height: 32px;
                            background: i == sel-profile ? #2d4263 : transparent;
                            border-radius: 5px;
                            TouchArea {
                                clicked => { sel-profile = i; load-profile(i); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    text: name;
                                    color: #e8eaed;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                }
                            }
                        }
                        }
                    }
                    Button {
                        text: "Apply profile";
                        primary: true;
                        enabled: hw-ok;
                        clicked => { apply-profile(sel-profile); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        new-name := LineEdit {
                            placeholder-text: "save as…";
                            font-size: 12px;
                        }
                        Button {
                            text: "Save";
                            clicked => {
                                if (new-name.text != "") {
                                    save-profile(new-name.text);
                                    new-name.text = "";
                                }
                            }
                        }
                    }
                    Button {
                        text: "Update selected";
                        clicked => { update-profile(sel-profile); }
                    }
                    Button {
                        text: "Delete selected";
                        clicked => { delete-profile(sel-profile); }
                    }

                    Rectangle { height: 1px; background: #2a2b2e; }

                    Text { text: "Run this profile in mode"; font-size: 11px; color: #9aa0a6; }
                    mode-box := ComboBox {
                        model: ["(no binding)", "Quiet", "Balanced", "Performance", "Extreme", "Custom"];
                        current-index: bind-mode;
                        selected => { bind-mode = self.current-index; }
                    }
                    Button {
                        text: "Bind";
                        clicked => { bind-profile(sel-profile, mode-box.current-index); }
                    }

                    Rectangle { height: 1px; background: #2a2b2e; }

                    Text { text: "Run this profile when"; font-size: 11px; color: #9aa0a6; }
                    power-box := ComboBox {
                        model: ["(never)", "on battery", "on AC",
                                "KDE power-saver", "KDE balanced", "KDE performance"];
                        current-index: bind-power;
                        selected => { bind-power = self.current-index; }
                    }
                    Button {
                        text: "Bind to power source";
                        clicked => { bind-power-source(sel-profile, power-box.current-index); }
                    }

                    Rectangle { height: 1px; background: #2a2b2e; }

                    CheckBox {
                        text: "Re-apply at boot";
                        checked <=> persist;
                        toggled => { set-persist(self.checked); }
                    }
                    Rectangle { min-height: 6px; }
                }
                }
            }

            // main pane
            TabWidget {
                Tab {
                    title: "Fan curve";
                    VerticalBox {
                        padding: 12px;
                        spacing: 10px;

                        // bar graph
                        Rectangle {
                            height: 150px;
                            background: #1a1b1e;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 4px;
                                for p[i] in curve: Rectangle {
                                    VerticalLayout {
                                        spacing: 3px;
                                        Rectangle { }  // spacer pushes the bar down
                                        Rectangle {
                                            height: 92px * (p.rpm / max(stats.fan-max, 1));
                                            background: @linear-gradient(180deg, #8ab4f8 0%, #4a6fa5 100%);
                                            border-radius: 3px;
                                        }
                                        Text {
                                            text: p.temp + "°";
                                            font-size: 9px;
                                            color: #9aa0a6;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Trip temperature and fan speed at each of the 10 hardware points. "
                                + "Temperatures must increase down the list.";
                            font-size: 11px;
                            color: #9aa0a6;
                            wrap: word-wrap;
                        }

                        ScrollView {
                            VerticalLayout {
                                spacing: 4px;
                                for p[i] in curve: HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;
                                    Text {
                                        text: (i + 1) + ".";
                                        width: 22px;
                                        color: #9aa0a6;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: "temp";
                                        width: 34px;
                                        color: #9aa0a6;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                    }
                                    t-edit := LineEdit {
                                        width: 62px;
                                        text: p.temp;
                                        font-size: 12px;
                                        edited => { point-changed(i, t-edit.text.to-float(), p.rpm); }
                                    }
                                    Text {
                                        text: "°C     rpm";
                                        width: 66px;
                                        color: #9aa0a6;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                    }
                                    r-edit := LineEdit {
                                        width: 74px;
                                        text: p.rpm;
                                        font-size: 12px;
                                        edited => { point-changed(i, p.temp, r-edit.text.to-float()); }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: stats.fan-max;
                                        value: p.rpm;
                                        changed(v) => { point-changed(i, p.temp, v); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Apply fan curve";
                                primary: true;
                                enabled: hw-ok;
                                clicked => { apply-curve(); }
                            }
                            Button {
                                text: "Reload firmware curve";
                                clicked => { restore-stock(); }
                            }
                        }
                    }
                }

                Tab {
                    title: "Power";
                    ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;

                        GroupBox {
                            title: "CPU";
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Sustained (PL1)"; width: 150px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    Slider {
                                        minimum: 15; maximum: 75; value: edit-pl1;
                                        changed(v) => { edit-pl1 = round(v); }
                                    }
                                    Text { text: edit-pl1 + " W"; width: 54px; color: #8ab4f8;
                                           vertical-alignment: center; font-weight: 700; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Burst (PL2)"; width: 150px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    Slider {
                                        minimum: 20; maximum: 140; value: edit-pl2;
                                        changed(v) => { edit-pl2 = round(v); }
                                    }
                                    Text { text: edit-pl2 + " W"; width: 54px; color: #8ab4f8;
                                           vertical-alignment: center; font-weight: 700; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "PL1 window"; width: 150px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    Slider {
                                        minimum: 1; maximum: 60; value: edit-tau;
                                        changed(v) => { edit-tau = round(v); }
                                    }
                                    Text { text: edit-tau + " s"; width: 54px; color: #8ab4f8;
                                           vertical-alignment: center; font-weight: 700; }
                                }
                                Text {
                                    text: "Stock is 55 W sustained with a 56 s window, which this chassis "
                                        + "cannot cool. A shorter window makes the limit bite before the "
                                        + "CPU reaches its thermal wall.";
                                    font-size: 11px; color: #9aa0a6; wrap: word-wrap;
                                }
                                Button {
                                    text: "Apply power limits";
                                    primary: true;
                                    enabled: hw-ok;
                                    clicked => { apply-power(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Undervolt";
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Core + cache offset"; width: 150px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    Slider {
                                        minimum: -150; maximum: 50; value: edit-uv;
                                        changed(v) => { edit-uv = round(v / 5) * 5; }
                                    }
                                    Text { text: edit-uv + " mV"; width: 66px;
                                           color: edit-uv > 0 ? #f28b82 : #81c995;
                                           vertical-alignment: center; font-weight: 700; }
                                }
                                Text {
                                    text: edit-uv > 0
                                        ? "POSITIVE IS OVERVOLT. It raises voltage, heat and wear. Only useful "
                                          + "to stabilise an overclock, and this chip has CPU overclocking "
                                          + "disabled in firmware, so there is nothing here for it to buy."
                                        : "Measured here at PL1 55 W: -100 mV gave +302 MHz, 6 C cooler and "
                                          + "4 W less, because this chip is thermally limited rather than power "
                                          + "limited. Below -125 mV can be unstable, and instability is not "
                                          + "always a clean crash.";
                                    font-size: 11px; color: #9aa0a6; wrap: word-wrap;
                                }
                                Button {
                                    text: edit-uv > 0 ? "Apply OVERVOLT" : "Apply undervolt";
                                    primary: true;
                                    enabled: hw-ok;
                                    clicked => { apply-undervolt(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "CPU ceiling";
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Max performance"; width: 150px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    Slider {
                                        minimum: 10; maximum: 100; value: edit-maxperf;
                                        changed(v) => { edit-maxperf = round(v); }
                                    }
                                    Text { text: edit-maxperf + " %"; width: 62px; color: #8ab4f8;
                                           vertical-alignment: center; font-weight: 700; }
                                }
                                Text {
                                    text: "Same knob as the Windows power plan 'maximum processor state'. "
                                        + "35% on battery matches that setting exactly.";
                                    font-size: 11px; color: #9aa0a6; wrap: word-wrap;
                                }
                                Button {
                                    text: "Apply CPU ceiling";
                                    enabled: hw-ok;
                                    clicked => { apply-maxperf(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Embedded controller";
                            VerticalLayout {
                                spacing: 10px;
                                SliderRow {
                                    label: "CPU throttle point"; minimum: 70; maximum: 100;
                                    unit: "°C"; value: edit-cpu-temp;
                                    changed(v) => { edit-cpu-temp = v; }
                                }
                                SliderRow {
                                    label: "Cross-loading limit"; minimum: 10; maximum: 65;
                                    unit: "W"; value: edit-crossload;
                                    changed(v) => { edit-crossload = v; }
                                }
                                SliderRow {
                                    label: "EC power window"; minimum: 4; maximum: 120; step: 4;
                                    unit: "s"; value: edit-ec-tau;
                                    changed(v) => { edit-ec-tau = v; }
                                }
                                CheckBox {
                                    text: "Couple PL1 and PL2";
                                    checked <=> tog-plcoupling;
                                    toggled => { set-flag("cpu_pl_coupling", self.checked); }
                                }
                                Note {
                                    text: "These are the firmware's own limits, separate from the RAPL "
                                        + "sliders above. Cross-loading is the CPU's share when the GPU is "
                                        + "also loaded. The EC window quantises to multiples of 4 s.";
                                }
                                Button {
                                    text: "Apply EC limits";
                                    enabled: hw-ok;
                                    clicked => { apply-ec-limits(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Power mode";
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Quiet"; clicked => { set-powermode(1); } }
                                Button { text: "Balanced"; clicked => { set-powermode(2); } }
                                Button { text: "Performance"; clicked => { set-powermode(3); } }
                                Button { text: "Extreme"; clicked => { set-powermode(224); } }
                                Button { text: "Custom"; clicked => { set-powermode(255); } }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                    }
                }

                Tab {
                    title: "GPU";
                    ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;

                        GroupBox {
                            title: extras.gpu-name == "" ? "GPU" : extras.gpu-name;
                            VerticalLayout {
                                spacing: 10px;
                                SliderRow {
                                    label: "cTGP"; minimum: 0; maximum: 80; unit: "W";
                                    value: edit-ctgp; changed(v) => { edit-ctgp = v; }
                                }
                                SliderRow {
                                    label: "Dynamic boost (PPAB)"; minimum: 0; maximum: 30; unit: "W";
                                    value: edit-ppab; changed(v) => { edit-ppab = v; }
                                }
                                Note {
                                    text: "The firmware clamps these to its own maximum. Total budget is "
                                        + "cTGP plus dynamic boost, and the card's own ceiling is "
                                        + extras.gpu-pl-max + " W.";
                                }
                                Button {
                                    text: "Apply GPU limits";
                                    primary: true;
                                    enabled: hw-ok;
                                    clicked => { apply-gpu(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Firmware GPU limits";
                            VerticalLayout {
                                spacing: 10px;
                                SliderRow {
                                    label: "GPU throttle point"; minimum: 70; maximum: 95;
                                    unit: "°C"; value: edit-gpu-temp;
                                    changed(v) => { edit-gpu-temp = v; }
                                }
                                SliderRow {
                                    label: "Power boost"; minimum: 0; maximum: 25; unit: "W";
                                    value: edit-gpu-boost; changed(v) => { edit-gpu-boost = v; }
                                }
                                SliderRow {
                                    label: "AC target offset"; minimum: 0; maximum: 30; unit: "W";
                                    value: edit-gpu-offset; changed(v) => { edit-gpu-offset = v; }
                                }
                                Note {
                                    text: "The sysfs node behind Power boost is named gpu_oc, but on this "
                                        + "firmware it carries watts rather than an on/off switch. AC target "
                                        + "offset raises the board's power target above its baseline while "
                                        + "the charger is connected.";
                                }
                                Button {
                                    text: "Apply firmware GPU limits";
                                    enabled: hw-ok;
                                    clicked => { apply-gpu-extra(); }
                                }
                            }
                        }

                        GroupBox {
                            title: "Discrete GPU";
                            VerticalLayout {
                                spacing: 6px;
                                Field { label: "Graphics mode";
                                        value: extras.igpu-mode == 0 ? "hybrid (dGPU available)"
                                                                     : "integrated only"; }
                                Field { label: "Holding it awake";
                                        value: gpu-clients.length == 0 ? "nothing — asleep"
                                                                       : gpu-clients.length + " client(s)"; }
                                for c in gpu-clients: Text {
                                    text: "   " + c;
                                    font-size: 11px;
                                    color: #c58af9;
                                }
                                Note {
                                    text: "Switching to integrated-only is deliberately not offered here. "
                                        + "On Windows the toolkit can do it live; on Linux the X or Wayland "
                                        + "session is already bound to the card and the switch would take "
                                        + "the desktop down with it. Use the BIOS if you want it off.";
                                }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                    }
                }

                Tab {
                    title: "Battery";
                    ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;

                        GroupBox {
                            title: "Charging";
                            VerticalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: "Conservation mode (stop charging near 60%)";
                                    checked <=> tog-conservation;
                                    toggled => {
                                        if (self.checked) { tog-rapid = false; }
                                        set-charge-mode(self.checked, tog-rapid);
                                    }
                                }
                                CheckBox {
                                    text: "Rapid charge";
                                    checked <=> tog-rapid;
                                    toggled => {
                                        if (self.checked) { tog-conservation = false; }
                                        set-charge-mode(tog-conservation, self.checked);
                                    }
                                }
                                Note {
                                    text: "The firmware treats these as mutually exclusive, so turning one "
                                        + "on clears the other. Conservation mode is the one that matters "
                                        + "for pack life if the machine lives on the charger.";
                                }
                            }
                        }

                        GroupBox {
                            title: "Pack";
                            VerticalLayout {
                                spacing: 2px;
                                Field { label: "Charge"; value: extras.bat-capacity + "%  ("
                                                              + extras.bat-status + ")"; }
                                Field { label: "Health";
                                        value: extras.bat-health + "% of design capacity"; }
                                Field { label: "Cycles"; value: extras.bat-cycles; }
                                Field { label: "Voltage";
                                        value: round(extras.bat-volts * 100) / 100 + " V"; }
                                Field { label: extras.bat-status == "Discharging" ? "Draining at"
                                                                                  : "Power flow";
                                        value: round(extras.bat-watts * 10) / 10 + " W"; }
                                Field { label: "Cell"; value: extras.bat-model; }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                    }
                }

                Tab {
                    title: "Keyboard";
                    ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;

                        GroupBox {
                            title: "Backlight";
                            VerticalLayout {
                                spacing: 10px;
                                SliderRow {
                                    label: "Brightness"; minimum: 0; maximum: 2; unit: "of 2";
                                    value: edit-kbd;
                                    changed(v) => { edit-kbd = v; apply-kbd(v); }
                                }
                                Note {
                                    text: "Three levels of white backlight — this chassis has no RGB zones, "
                                        + "so there is nothing for a colour picker to drive.";
                                }
                            }
                        }

                        GroupBox {
                            title: "Turn off when idle";
                            VerticalLayout {
                                spacing: 10px;
                                CheckBox {
                                    text: "Switch the backlight off after a period without input";
                                    checked <=> tog-kbd-idle;
                                    toggled => { apply-kbd-idle(self.checked, edit-kbd-idle-secs); }
                                }
                                SliderRow {
                                    label: "Turn off after"; minimum: 1; maximum: 120; unit: "s";
                                    value: edit-kbd-idle-secs;
                                    enabled: tog-kbd-idle;
                                    changed(v) => { edit-kbd-idle-secs = v; apply-kbd-idle(tog-kbd-idle, v); }
                                }
                                Note {
                                    text: "Comes back on at the first keypress or mouse move, to the level set above. "
                                        + "Runs as a user service (83sc-kbd-idle) so it survives logout and reboot.";
                                }
                            }
                        }

                        GroupBox {
                            title: "Keys and touchpad";
                            VerticalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: "Fn lock (media keys need Fn held)";
                                    checked <=> tog-fnlock;
                                    toggled => { set-flag("fn_lock", self.checked); }
                                }
                                CheckBox {
                                    text: "Windows key enabled";
                                    checked <=> tog-winkey;
                                    toggled => { set-flag("winkey", self.checked); }
                                }
                                CheckBox {
                                    text: "Touchpad enabled";
                                    checked <=> tog-touchpad;
                                    toggled => { set-flag("touchpad", self.checked); }
                                }
                                CheckBox {
                                    text: "Flip to start (open the lid to power on)";
                                    checked <=> tog-flip;
                                    toggled => { set-flag("flip_to_start", self.checked); }
                                }
                                Note {
                                    text: "Turning the touchpad off takes effect immediately, so keep the "
                                        + "keyboard within reach if you want it back.";
                                }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                    }
                }

                Tab {
                    title: "Display";
                    ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;

                        GroupBox {
                            title: "Panel";
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Refresh rate"; width: 158px; color: #e8eaed;
                                           vertical-alignment: center; font-size: 12px; }
                                    hz-box := ComboBox {
                                        model: refresh-options;
                                        current-index: edit-refresh-idx;
                                        selected => {
                                            edit-refresh-idx = self.current-index;
                                            apply-refresh(self.current-index);
                                        }
                                    }
                                    Text { text: "now " + extras.refresh-hz + " Hz"; width: 76px;
                                           color: #8ab4f8; vertical-alignment: center;
                                           font-weight: 700; font-size: 12px; }
                                }
                                CheckBox {
                                    text: "Overdrive (faster pixel response)";
                                    checked <=> tog-overdrive;
                                    toggled => { set-flag("overdrive", self.checked); }
                                }
                                Note {
                                    text: "Refresh rate goes through the compositor, so it applies straight "
                                        + "away and survives on its own. Dropping to 60 Hz is worth a few "
                                        + "watts on battery. HDR and G-Sync are not offered because this "
                                        + "panel reports itself incapable of the first and the firmware "
                                        + "reports no support for the second.";
                                }
                            }
                        }
                        Rectangle { min-height: 8px; }
                    }
                    }
                }
            }
        }

        Rectangle {
            height: 26px;
            Text {
                text: status;
                color: status-error ? #f28b82 : #9aa0a6;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
